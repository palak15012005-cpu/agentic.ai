# Agentic AI Academy – Environment Configuration
# Production Domain: https://mindwash.ai

# Port for the Node.js server (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Application URL
APP_URL="https://mindwash.ai"

# Cryptographic Session Secret for Admin Authentication Cookies
SESSION_SECRET="your-secure-random-32-character-session-secret"

# Initial Admin Password (Used on initial bootstrap provisioning if not pre-seeded)
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction2026!"

# Optional: SMTP Email Notification Settings
# When omitted, all enquiries continue to be stored safely in the database
# and marked with notificationStatus: 'stored_pending_smtp_config'.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="admissions@mindwash.ai"

# Gemini AI API Key (Injected by AI Studio if AI features are configured)
GEMINI_API_KEY=""
